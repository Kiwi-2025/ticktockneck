{
  "name": "ticktockneck",
  "version": "1.1.2",
  "description": "Neck-activity reminder (pomodoro-style)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "smoke": "electron scripts/smoke.js",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.ticktockneck.app",
    "win": {
      "icon": "build/icon.png"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "reminder.html",
      "reminder.js",
      "styles.css",
      "logo.jpg",
      "lib/**/*",
      "gif/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
